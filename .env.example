# Property Desk / EstateOS — environment variables.
#
# Copy to `.env` and fill in real values. This file is committed on purpose:
# every value below is a placeholder, and no real credential belongs in Git.
# `.env` itself is git-ignored (see .gitignore).
#
# The app needs only the three SUPABASE_* values to boot; the Twilio values
# are only needed for property check-in messages.

# Deployment identity. Set to "staging" only in a dedicated staging Worker;
# the staging webhook smoke script requires its identity endpoint to confirm it.
ESTATEOS_DEPLOYMENT_ENV=local

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project URL. Use the direct project host, e.g.
#   https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Client-side publishable key. Safe to ship in the browser bundle: it carries
# no privileges on its own, and every table is protected by row-level
# security. Newer projects use the opaque form (starts with "sb_publishable_"),
# older ones use the legacy anon JWT.
SUPABASE_PUBLISHABLE_KEY=

# Server-side service-role key (secret). Bypasses row-level security, so it is
# only ever read inside *.server.ts modules and server functions. Never commit
# the real value, and never import it from a file that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Vite copies these into the client bundle at build time, so the browser can
# talk to Supabase. Same values as above; both spellings are supported
# (src/integrations/supabase/client.ts prefers the VITE_ prefix).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Test-data seeding (scripts/seed-test-data.mjs / clear-test-data.mjs)
# ---------------------------------------------------------------------------
# Both values are REQUIRED before either script will run, and both are
# deliberately empty here: .env.example is committed, .env is not.
#
# SEED_ALLOWED_PROJECT_REF is a safety interlock, not a credential. The scripts
# parse the project ref out of SUPABASE_URL above and REFUSE to run unless this
# value equals it -- so a copied .env can never seed a real project by accident.
# The ref is the first label of the Supabase host:
#   https://abcdefghijklmnop.supabase.co -> abcdefghijklmnop
SEED_ALLOWED_PROJECT_REF=

# Password given to the @test.estateos.local accounts the seed creates. Never
# printed by the scripts. Use a throwaway value: these are fake accounts in a
# project you have explicitly allow-listed above.
SEED_TEST_PASSWORD=

# ---------------------------------------------------------------------------
# Database migrations
# ---------------------------------------------------------------------------
# Direct Postgres URL used only by node scripts/apply-migrations.mjs to apply
# drizzle migrations. NOT read by the app at runtime.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Note: `drizzle-kit migrate` cannot apply migrations 0002-0008 —
# drizzle/migrations/meta/_journal.json only tracks 0000 and 0001. To preview local
# files without connecting, use:
#   node scripts/apply-migrations.mjs --dry-run --from 0014
# Supabase writes require --only <single-migration>, --confirm-project-ref,
# --confirm-reconciled-schema, and --confirm-production-write after explicit approval.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Property check-in messaging (optional; live sending stays off by default)
# ---------------------------------------------------------------------------
# Twilio currently supports SMS only. WhatsApp check-ins open a draft in the
# user's own WhatsApp app; automated WhatsApp requires each agency's own Meta
# connection. Set live send true only after applying the consent migration and
# configuring the production safeguards.
MESSAGING_LIVE_SEND=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender numbers, e.g. +923001234567
TWILIO_SMS_FROM=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API via Meta Embedded Signup (optional until Meta setup)
# ---------------------------------------------------------------------------
# Configure a Meta app with Facebook Login for Business / Embedded Signup v4,
# WhatsApp Cloud API, webhooks, and the required reviewed permissions. These
# values are server-side secrets except META_APP_ID / META_EMBEDDED_SIGNUP_CONFIG_ID,
# which are returned to the authenticated agency admin by a server function.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Must be a current Graph API version enabled on the Meta app, e.g. vXX.X.
META_GRAPH_API_VERSION=
# Random independent secret used by Meta's webhook GET verification.
META_WEBHOOK_VERIFY_TOKEN=
# Automated scheduled WhatsApp messages remain disabled until template review,
# consent capture, HTTPS webhook setup, and production checks are complete.
WHATSAPP_LIVE_SEND=false
# Generate a random 32-byte key and base64 encode it. Used for AES-256-GCM token storage.
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AI-assisted WhatsApp replies (optional)
# ---------------------------------------------------------------------------
# The model identifier is deliberately explicit; choose one enabled for the API project.
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------------------------
# Cron (optional, deployment-specific)
# ---------------------------------------------------------------------------
# Bearer token the check-in cron endpoint requires, plus the previous token
# during a rotation window. Generate with: openssl rand -hex 32
CRON_SECRET=
CRON_SECRET_PREVIOUS=

# ---------------------------------------------------------------------------
# Team invitations (optional)
# ---------------------------------------------------------------------------
# If either of these is set, the invite dialog also emails the invitation
# link. If neither is set, the app shows the link for the admin to copy and
# send themselves (WhatsApp, SMS, anything) -- which is the default and is
# fully functional without SMTP.
SMTP_HOST=
RESEND_API_KEY=
