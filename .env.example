# Client-visible Supabase configuration (publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server runtime configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required only for the one-time platform-owner bootstrap flow.
# Keep this secret on the server. Never prefix it with VITE_.
PLATFORM_BOOTSTRAP_SECRET=

# Official Meta WhatsApp Cloud API (server-only; never use VITE_ prefixes)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
META_TOKEN_ENCRYPTION_KEY=
META_WEBHOOK_VERIFY_TOKEN=

# AI replies (keep this key server-side; configure it in both app hosting and Supabase Edge Function secrets).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_MAX_REPLIES_PER_AGENCY_PER_DAY=2000
AI_MAX_REPLIES_PER_CONVERSATION_PER_HOUR=20
