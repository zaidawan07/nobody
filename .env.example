# Property Desk / EstateOS — environment variables.
#
# Copy to `.env` and fill in real values. This file is committed on purpose:
# every value below is a placeholder, and no real credential belongs in Git.
# `.env` itself is git-ignored (see .gitignore).
#
# The app needs only the three SUPABASE_* values to boot; the Twilio values
# are only needed for property check-in messages.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project URL. Use the direct project host, e.g.
#   https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Client-side publishable key. Safe to ship in the browser bundle: it carries
# no privileges on its own, and every table is protected by row-level
# security. Newer projects use the opaque form (starts with "sb_publishable_"),
# older ones use the legacy anon JWT.
SUPABASE_PUBLISHABLE_KEY=

# Server-side service-role key (secret). Bypasses row-level security, so it is
# only ever read inside *.server.ts modules and server functions. Never commit
# the real value, and never import it from a file that ships to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Vite copies these into the client bundle at build time, so the browser can
# talk to Supabase. Same values as above; both spellings are supported
# (src/integrations/supabase/client.ts prefers the VITE_ prefix).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Test-data seeding (scripts/seed-test-data.mjs / clear-test-data.mjs)
# ---------------------------------------------------------------------------
# Both values are REQUIRED before either script will run, and both are
# deliberately empty here: .env.example is committed, .env is not.
#
# SEED_ALLOWED_PROJECT_REF is a safety interlock, not a credential. The scripts
# parse the project ref out of SUPABASE_URL above and REFUSE to run unless this
# value equals it -- so a copied .env can never seed a real project by accident.
# The ref is the first label of the Supabase host:
#   https://abcdefghijklmnop.supabase.co -> abcdefghijklmnop
SEED_ALLOWED_PROJECT_REF=

# Password given to the @test.estateos.local accounts the seed creates. Never
# printed by the scripts. Use a throwaway value: these are fake accounts in a
# project you have explicitly allow-listed above.
SEED_TEST_PASSWORD=

# ---------------------------------------------------------------------------
# Database migrations
# ---------------------------------------------------------------------------
# Direct Postgres URL used only by node scripts/apply-migrations.mjs to apply
# drizzle migrations. NOT read by the app at runtime.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Note: `drizzle-kit migrate` cannot apply migrations 0002-0008 —
# drizzle/migrations/meta/_journal.json only tracks 0000 and 0001. Use the
# script instead:
#   node scripts/apply-migrations.mjs
DATABASE_URL=

# ---------------------------------------------------------------------------
# Property check-in messaging (optional)
# ---------------------------------------------------------------------------
# Twilio credentials for the scheduled property check-ins sent by
# src/routes/api/cron/property-checkins.ts. Without these, check-ins stay
# "scheduled"/"failed" instead of silently reporting as sent — the app never
# pretends a message was delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sender numbers, e.g. +923001234567
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---------------------------------------------------------------------------
# Cron (optional, deployment-specific)
# ---------------------------------------------------------------------------
# Bearer token the check-in cron endpoint requires, plus the previous token
# during a rotation window. Generate with: openssl rand -hex 32
CRON_SECRET=
CRON_SECRET_PREVIOUS=
